doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    title Detalle de Película
    link(rel="stylesheet", href="/css/style.css")
  body
    div.container
      if error
        h2(style="color: red;")= error
        br
        a(href="/") Volver al buscador
      else
        h1= movie.Title
        p **Director:** #{movie.Director}
        p **Año:** #{movie.Year}
        p **Género:** #{movie.Genre}
        p **Sinopsis:** #{movie.Plot}
        if movie.Poster && movie.Poster !== "N/A"
          div
            img(src=movie.Poster, alt=movie.Title, style="max-width: 300px; border-radius: 8px;")
        br
        br
        a(href="/") Realizar otra búsqueda