doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    title Buscador de Películas - OMDB
    link(rel="stylesheet", href="/css/style.css")
  body
    div.container
      h1 Buscador de Películas
      form(action="/film", method="POST")
        input(type="text", name="title", class="input-text", placeholder="Escribe el título...", required)
        input(type="submit", class="input-submit", value="Buscar Película")